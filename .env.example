# Copy to .env.local for local development (never commit real keys).
# Vite exposes only VITE_* variables to the browser.

# Odds API (The Odds API)
VITE_ODDS_API_KEY=
ODDS_API_KEY=
THE_ODDS_API_KEY=

# SportsDataIO MLB subscription key
VITE_SPORTSDATAIO_API_KEY=
VITE_SPORTSDATA_API_KEY=
SPORTSDATAIO_API_KEY=
SPORTSDATA_API_KEY=
SPORTS_DATA_IO_API_KEY=

# Optional StatMuse enrichment
VITE_STATMUSE_API_KEY=

# Optional DFS proxy providers
VITE_PRIZEPICKS_PROXY_URL=
VITE_UNDERDOG_PROXY_URL=

# Server-side only (Node / Vercel proxy routes)
APIFY_TOKEN=
